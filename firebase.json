{
  "hosting": {
    "public": "frontend/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/menu/qr/**",
        "destination": "/menu/qr/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}