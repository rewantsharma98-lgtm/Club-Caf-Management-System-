PORT=5000

# --- Option A: MongoDB Atlas (cloud) ---
# Atlas → Database → Connect → Drivers → copy URI (one line, no spaces)
# MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/openhousecafe?retryWrites=true&w=majority

# --- Option B: Local Docker (recommended if Atlas blocks your IP) ---
# Run: docker compose up -d
MONGODB_URI=mongodb://127.0.0.1:27017/openhousecafe

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

ADMIN_EMAIL=admin@openhousecafe.com
ADMIN_PASSWORD=Admin@12345
ADMIN_USERNAME=admin

SUPER_ADMIN_EMAIL=super@openhousecafe.com
SUPER_ADMIN_PASSWORD=Super@12345
